{
  "manifest_version": 3,
  "name": "Google Chat Exporter",
  "version": "2.2.0",
  "description": "Export Google Chat conversations to TXT or HTML with media. 100% private — no data leaves your browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "google-chat-exporter@vishwas-r",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Google Chat Exporter"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://chat.google.com/*",
    "https://mail.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*",
    "https://*.googleapis.com/*"
  ],
  "background": {
    "scripts": ["lib/jszip.min.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["selectors.json", "lib/jszip.min.js", "icons/*"],
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
